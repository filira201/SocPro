// Prisma schema — PostgreSQL.
// Миграция с MongoDB выполнена: ObjectId → cuid, парные m2m-массивы → явные join-таблицы,
// каскады реализованы через нативные FK ON DELETE.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  firstName   String
  lastName    String?
  patronymic  String?
  password    String
  avatarUrl   String?
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bio         String?
  university  String?
  course      String?
  faculty     String?

  /** Резюме (PDF/Word), 1:1 — отдельная таблица UserResume. */
  resume UserResume?
  /** Контакты (произвольные строки), 1:N — таблица UserContact с полем position. */
  contactList UserContact[]

  posts        Post[]
  likes        Like[]
  comments     Comment[]
  commentLikes CommentLike[]
  followers    Follows[]     @relation("following")
  following    Follows[]     @relation("follower")

  /** Явная join-таблица User↔Skill (заменила парные массивы skillIds/userIds). */
  skills UserSkill[]

  ownedProjects Project[]            @relation("ProjectOwner")
  memberships   ProjectMember[]
  applications  ProjectApplication[] @relation("ApplicationApplicant")
  /** Заявки, созданные этим пользователем как приглашения (invitedBy). */
  sentProjectInvitations ProjectApplication[] @relation("ApplicationInvitedBy")
  /** Заявки/приглашения, по которым этот пользователь принял решение (принял/отклонил). */
  decidedProjectApplications ProjectApplication[] @relation("ApplicationDecidedBy")

  /** Входящие уведомления (получатель). */
  receivedNotifications Notification[] @relation("NotificationReceiver")
  /** Исходящие действия в уведомлениях (кто лайкнул, прокомментировал и т.д.). */
  actorNotifications Notification[] @relation("NotificationActor")
  /** Второй участник события (например приглашённый в уведомлении для staff «A пригласил B»). */
  subjectNotifications Notification[] @relation("NotificationSubject")
}

/** Резюме пользователя (PDF/Word), не более одного на пользователя. */
model UserResume {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url          String
  originalName String?
  mimeType     String
  size         Int
  uploadedAt   DateTime @default(now())
}

/** Контакт пользователя (произвольная строка: tg, tel, email и т.д.). */
model UserContact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     String
  /** Порядок отображения (0-based), совпадает с порядком ввода в форме. */
  position  Int
  createdAt DateTime @default(now())

  @@index([userId, position])
}

model Follows {
  id          String @id @default(cuid())
  follower    User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String

  @@unique([followerId, followingId])
  @@index([followingId, followerId])
}

model Post {
  id          String           @id @default(cuid())
  content     String
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  likes       Like[]
  comments    Comment[]
  attachments PostAttachment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

model Like {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id          String              @id @default(cuid())
  content     String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  post        Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  /** Self-reference; на удалении родителя ставим NULL (приложение само сносит дерево). */
  parentId    String?
  parent      Comment?            @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     Comment[]           @relation("CommentReplies")
  likes       CommentLike[]
  attachments CommentAttachment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([postId])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model PostAttachment {
  id           String   @id @default(cuid())
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       String
  url          String
  filename     String
  originalName String?
  mimeType     String
  size         Int
  kind         String
  createdAt    DateTime @default(now())

  @@index([postId])
}

model CommentAttachment {
  id           String   @id @default(cuid())
  comment      Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId    String
  url          String
  filename     String
  originalName String?
  mimeType     String
  size         Int
  kind         String
  createdAt    DateTime @default(now())

  @@index([commentId])
}

model Skill {
  id   String @id @default(cuid())
  name String @unique

  /** Явные join-таблицы вместо парных массивов. */
  users    UserSkill[]
  projects ProjectRequiredSkill[]

  /** Нормализованные ключи и синонимы для точного маппинга + индекса Fuse */
  aliases SkillAlias[]
}

/** Один канонический навык — много ключей после clean() (синонимы + опечатки через Fuse по haystack). */
model SkillAlias {
  id      String @id @default(cuid())
  /** Уникальный нормализованный ключ: lower, trim, без точек, один пробел между словами */
  key     String @unique
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

/** Явная join-таблица User↔Skill. */
model UserSkill {
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId String

  @@id([userId, skillId])
  @@index([skillId])
}

/** Явная join-таблица Project↔Skill (требуемые навыки проекта). */
model ProjectRequiredSkill {
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId   String

  @@id([projectId, skillId])
  @@index([skillId])
}

model Project {
  id          String        @id @default(cuid())
  /// Обязательно непустое после trim, до 500 символов — проверка в API.
  title       String
  /// Обязательно непустое после trim, до 5000 символов — проверка в API.
  description String
  /// Обязательно непустое после trim, до 5000 символов — проверка в API.
  goals       String
  status      ProjectStatus @default(OPEN)
  /** Последнее изменение поля status (для UI «время в текущем статусе»). */
  statusUpdatedAt DateTime @default(now())
  /** Рубильник приёма новых заявок (не путать с ProjectStatus). */
  acceptingApplications Boolean @default(true)

  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  requiredSkills ProjectRequiredSkill[]

  members      ProjectMember[]
  applications ProjectApplication[]
  attachments  ProjectAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([createdAt])
}

/** Вложения проекта (PDF/Word); не более 10 на проект — инвариант в приложении. */
model ProjectAttachment {
  id           String   @id @default(cuid())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  url          String
  filename     String
  originalName String?
  mimeType     String
  size         Int
  kind         String
  createdAt    DateTime @default(now())

  @@index([projectId])
}

model ProjectMember {
  id        String     @id @default(cuid())
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectApplication {
  id          String            @id @default(cuid())
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  applicant   User              @relation("ApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId String
  /** Если задано — заявка создана владельцем/админом как приглашение, а не самим соискателем. */
  invitedById String?
  invitedBy   User?             @relation("ApplicationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /** Кто принял или отклонил заявку (владелец/админ); при принятии приглашения самим приглашённым — он же. */
  decidedById String?
  decidedBy   User?             @relation("ApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// До 1000 символов после trim; пустое не сохраняется (undefined) — проверка в API.
  message     String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?

  /** Не более одной активной PENDING/ACCEPTED на пару (projectId, applicantId) — проверка в приложении. */
  @@index([projectId, applicantId])
  @@index([applicantId])
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  PAUSED
  DONE
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

/**
 * Входящее уведомление одному пользователю.
 *
 * Жизненный цикл прочитанных:
 * - `readAt` заполняется при отметке «прочитано».
 * - `deleteAt` = момент удаления документа; при прочтении выставляется `readAt + 7 дней`.
 * - Удаление по таймеру в PostgreSQL делается сервисом приложения
 *   (`backend/lib/notifications-ttl.js`): периодический `deleteMany` по `deleteAt <= now`.
 *   Пока `deleteAt` IS NULL — уведомление не истекает (непрочитанные не удаляются по времени).
 */
model Notification {
  id String @id @default(cuid())

  receiverId String
  receiver   User   @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  /** Кто совершил действие (лайк, комментарий, подписка, подал заявку и т.д.). Для чисто системных событий может быть null. */
  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /**
   * Доп. пользователь в смысле события (например приглашённый в `STAFF_INVITE_SENT`:
   * actor = кто отправил приглашение, subject = кого пригласили).
   */
  subjectUserId String?
  subjectUser   User?   @relation("NotificationSubject", fields: [subjectUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  type NotificationType

  /** Маршрутизация в UI (пост/ветка комментариев). */
  postId    String?
  commentId String?

  /** Проектные события; после удаления проекта `projectId` может быть null, см. `projectTitleSnapshot`. */
  projectId       String?
  applicationId String?

  /** Снимок названия для `PROJECT_DELETED`, когда проекта уже нет в БД. */
  projectTitleSnapshot String?

  readAt   DateTime?
  /** Заполняется при прочтении: `readAt + 7d` — автоудаление сервисом TTL по этому полю. */
  deleteAt DateTime?

  createdAt DateTime @default(now())

  @@index([receiverId, createdAt])
  @@index([receiverId, readAt])
  @@index([deleteAt])
}

enum NotificationType {
  // Лента: лайки и комментарии
  POST_LIKED
  COMMENT_LIKED
  POST_COMMENTED
  COMMENT_REPLIED

  // Подписки
  USER_FOLLOWED

  // Проект — соискатель / участник (личные события)
  /** Пользователь подал заявку (карточка «на какой проект и когда»). */
  PROJECT_APPLICATION_SUBMITTED_SELF
  /** Пользователь отозвал свою заявку (аналогичная карточка). */
  PROJECT_APPLICATION_WITHDRAWN_SELF
  /** Пользователь отклонил входящее приглашение в проект. */
  PROJECT_INVITE_DECLINED_SELF
  /** Заявку приняли или приглашение принято — пользователь стал участником. */
  PROJECT_APPLICATION_ACCEPTED
  /** Заявку отклонили (модератор/владелец). */
  PROJECT_APPLICATION_REJECTED
  /** Владелец/админ прислал приглашение в проект. */
  PROJECT_INVITE_RECEIVED
  /** Назначили роль ADMIN. */
  PROJECT_MEMBER_PROMOTED_ADMIN
  /** Сняли роль ADMIN (остался участником). */
  PROJECT_MEMBER_DEMOTED_FROM_ADMIN
  /** Исключили из проекта. */
  PROJECT_MEMBER_REMOVED
  /** Проект удалён владельцем (участникам/бывшим участникам). */
  PROJECT_DELETED

  // Проект — владелец и ADMIN (сводка по команде и заявкам)
  STAFF_NEW_APPLICATION
  STAFF_APPLICATION_WITHDRAWN
  /** Приглашённый пользователь отклонил приглашение (для owner/ADMIN). */
  STAFF_INVITE_DECLINED_BY_INVITEE
  STAFF_INVITE_SENT
  STAFF_INVITE_ACCEPTED
}
