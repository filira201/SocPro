// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  email       String    @unique
  firstName   String
  lastName    String?
  patronymic  String?
  password    String
  avatarUrl   String?
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bio         String?
  contacts    String[]  @default([])
  university  String?
  course      String?
  faculty     String?
  resumeUrl   String?
  resumeOriginalName String?
  resumeMimeType     String?
  resumeSize  Int?

  posts     Post[]
  likes     Like[]
  comments  Comment[]
  commentLikes CommentLike[]
  followers Follows[] @relation("following")
  following Follows[] @relation("follower")

  skillIds String[] @db.ObjectId
  skills   Skill[]  @relation(fields: [skillIds], references: [id])

  ownedProjects Project[]            @relation("ProjectOwner")
  memberships   ProjectMember[]
  applications  ProjectApplication[] @relation("ApplicationApplicant")
  /** Заявки, созданные этим пользователем как приглашения (invitedBy). */
  sentProjectInvitations ProjectApplication[] @relation("ApplicationInvitedBy")
  /** Заявки/приглашения, по которым этот пользователь принял решение (принял/отклонил). */
  decidedProjectApplications ProjectApplication[] @relation("ApplicationDecidedBy")

  /** Входящие уведомления (получатель). */
  receivedNotifications Notification[] @relation("NotificationReceiver")
  /** Исходящие действия в уведомлениях (кто лайкнул, прокомментировал и т.д.). */
  actorNotifications Notification[] @relation("NotificationActor")
  /** Второй участник события (например приглашённый в уведомлении для staff «A пригласил B»). */
  subjectNotifications Notification[] @relation("NotificationSubject")
}

model Follows {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  follower    User   @relation("follower", fields: [followerId], references: [id])
  followerId  String @db.ObjectId
  following   User   @relation("following", fields: [followingId], references: [id])
  followingId String @db.ObjectId

  @@unique([followerId, followingId])
}

model Post {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  content     String
  author      User             @relation(fields: [authorId], references: [id])
  authorId    String           @db.ObjectId
  likes       Like[]
  comments    Comment[]
  attachments PostAttachment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Like {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
  userId String @db.ObjectId
  post   Post   @relation(fields: [postId], references: [id])
  postId String @db.ObjectId

  @@unique([userId, postId])
}

model Comment {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  content     String
  user        User                @relation(fields: [userId], references: [id])
  userId      String              @db.ObjectId
  post        Post                @relation(fields: [postId], references: [id])
  postId      String              @db.ObjectId
  parentId    String?             @db.ObjectId
  parent      Comment?            @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     Comment[]           @relation("CommentReplies")
  likes       CommentLike[]
  attachments CommentAttachment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model CommentLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  commentId String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
}

model PostAttachment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  post         Post     @relation(fields: [postId], references: [id])
  postId       String   @db.ObjectId
  url          String
  filename     String
  originalName String?
  mimeType     String
  size         Int
  kind         String
  createdAt    DateTime @default(now())
}

model CommentAttachment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  comment      Comment  @relation(fields: [commentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  commentId    String   @db.ObjectId
  url          String
  filename     String
  originalName String?
  mimeType     String
  size         Int
  kind         String
  createdAt    DateTime @default(now())
}

model Skill {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique

  userIds String[] @db.ObjectId
  users   User[]   @relation(fields: [userIds], references: [id])

  projectIds String[]  @db.ObjectId
  projects   Project[] @relation(fields: [projectIds], references: [id])

  /** Нормализованные ключи и синонимы для точного маппинга + индекса Fuse */
  aliases SkillAlias[]
}

/** Один канонический навык — много ключей после clean() (синонимы + опечатки через Fuse по haystack). */
model SkillAlias {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  /** Уникальный нормализованный ключ: lower, trim, без точек, один пробел между словами */
  key     String @unique
  skillId String @db.ObjectId
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model Project {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  /// Обязательно непустое после trim, до 500 символов — проверка в API.
  title       String
  /// Обязательно непустое после trim, до 5000 символов — проверка в API.
  description String
  /// Обязательно непустое после trim, до 5000 символов — проверка в API.
  goals       String
  status      ProjectStatus @default(OPEN)
  /** Последнее изменение поля status (для UI «время в текущем статусе»). */
  statusUpdatedAt DateTime @default(now())
  /** Рубильник приёма новых заявок (не путать с ProjectStatus). */
  acceptingApplications Boolean @default(true)

  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id])
  ownerId String @db.ObjectId

  requiredSkillIds String[] @db.ObjectId
  requiredSkills   Skill[]  @relation(fields: [requiredSkillIds], references: [id])

  members      ProjectMember[]
  applications ProjectApplication[]
  attachments  ProjectAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Вложения проекта (PDF/Word); не более 10 на проект — инвариант в приложении. */
model ProjectAttachment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String   @db.ObjectId
  url          String
  filename     String
  originalName String?
  mimeType     String
  size         Int
  kind         String
  createdAt    DateTime @default(now())
}

model ProjectMember {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  project   Project    @relation(fields: [projectId], references: [id])
  projectId String     @db.ObjectId
  user      User       @relation(fields: [userId], references: [id])
  userId    String     @db.ObjectId
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())

  @@unique([projectId, userId])
}

model ProjectApplication {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  project     Project           @relation(fields: [projectId], references: [id])
  projectId   String            @db.ObjectId
  applicant   User              @relation("ApplicationApplicant", fields: [applicantId], references: [id])
  applicantId String            @db.ObjectId
  /** Если задано — заявка создана владельцем/админом как приглашение, а не самим соискателем. */
  invitedById String?           @db.ObjectId
  invitedBy   User?             @relation("ApplicationInvitedBy", fields: [invitedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /** Кто принял или отклонил заявку (владелец/админ); при принятии приглашения самим приглашённым — он же. */
  decidedById String?           @db.ObjectId
  decidedBy   User?             @relation("ApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// До 1000 символов после trim; пустое не сохраняется (undefined) — проверка в API.
  message     String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?

  /** Не более одной активной PENDING/ACCEPTED на пару (projectId, applicantId) — проверка в приложении. */
  @@index([projectId, applicantId])
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  PAUSED
  DONE
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

/**
 * Входящее уведомление одному пользователю.
 *
 * Жизненный цикл прочитанных:
 * - `readAt` заполняется при отметке «прочитано».
 * - `deleteAt` = момент удаления документа; при прочтении выставляется `readAt + 7 дней`.
 * - В Mongo вручную создать TTL-индекс: `db.Notification.createIndex({ deleteAt: 1 }, { expireAfterSeconds: 0 })`
 *   (Prisma не создаёт TTL). Пока `deleteAt` null — документ не истекает (**непрочитанные не удаляются по времени**).
 */
model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  receiverId String @db.ObjectId
  receiver   User   @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  /** Кто совершил действие (лайк, комментарий, подписка, подал заявку и т.д.). Для чисто системных событий может быть null. */
  actorId String? @db.ObjectId
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /**
   * Доп. пользователь в смысле события (например приглашённый в `STAFF_INVITE_SENT`:
   * actor = кто отправил приглашение, subject = кого пригласили).
   */
  subjectUserId String? @db.ObjectId
  subjectUser   User?   @relation("NotificationSubject", fields: [subjectUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  type NotificationType

  /** Маршрутизация в UI (пост/ветка комментариев). */
  postId    String? @db.ObjectId
  commentId String? @db.ObjectId

  /** Проектные события; после удаления проекта `projectId` может быть null, см. `projectTitleSnapshot`. */
  projectId       String? @db.ObjectId
  applicationId String? @db.ObjectId

  /** Снимок названия для `PROJECT_DELETED`, когда проекта уже нет в БД. */
  projectTitleSnapshot String?

  readAt   DateTime?
  /** Заполняется при прочтении: `readAt + 7d` — автоудаление через TTL-индекс по этому полю. */
  deleteAt DateTime?

  createdAt DateTime @default(now())

  @@index([receiverId, createdAt])
  @@index([receiverId, readAt])
  @@index([deleteAt])
}

enum NotificationType {
  // Лента: лайки и комментарии
  POST_LIKED
  COMMENT_LIKED
  POST_COMMENTED
  COMMENT_REPLIED

  // Подписки
  USER_FOLLOWED

  // Проект — соискатель / участник (личные события)
  /** Пользователь подал заявку (карточка «на какой проект и когда»). */
  PROJECT_APPLICATION_SUBMITTED_SELF
  /** Пользователь отозвал свою заявку (аналогичная карточка). */
  PROJECT_APPLICATION_WITHDRAWN_SELF
  /** Пользователь отклонил входящее приглашение в проект. */
  PROJECT_INVITE_DECLINED_SELF
  /** Заявку приняли или приглашение принято — пользователь стал участником. */
  PROJECT_APPLICATION_ACCEPTED
  /** Заявку отклонили (модератор/владелец). */
  PROJECT_APPLICATION_REJECTED
  /** Владелец/админ прислал приглашение в проект. */
  PROJECT_INVITE_RECEIVED
  /** Назначили роль ADMIN. */
  PROJECT_MEMBER_PROMOTED_ADMIN
  /** Сняли роль ADMIN (остался участником). */
  PROJECT_MEMBER_DEMOTED_FROM_ADMIN
  /** Исключили из проекта. */
  PROJECT_MEMBER_REMOVED
  /** Проект удалён владельцем (участникам/бывшим участникам). */
  PROJECT_DELETED

  // Проект — владелец и ADMIN (сводка по команде и заявкам)
  STAFF_NEW_APPLICATION
  STAFF_APPLICATION_WITHDRAWN
  STAFF_INVITE_SENT
  STAFF_INVITE_ACCEPTED
}
